# ─── Menopausia Plana funnel ────────────────────────────────────────────────
# Dodo Payments (https://app.dodopayments.com → Developer → API keys)
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
# test_mode | live_mode
DODO_PAYMENTS_ENVIRONMENT=

# Public base URL used to build Dodo return_url + download links (no trailing slash).
# Local: http://localhost:4321 · Prod: https://tu-dominio.com
PUBLIC_SITE_URL=

# File delivery (we deliver the PDFs, Dodo does not)
# Resend email (https://resend.com → API Keys). If empty, the funnel still works
# (no email sent). EMAIL_FROM must be a verified sender, e.g. "Marca <hola@tu-dominio.com>".
RESEND_API_KEY=
EMAIL_FROM=
# Long random secret used to sign download tokens (HMAC). Generate with:
#   openssl rand -hex 32
DOWNLOAD_SECRET=

# Meta Pixel (client, injected only on /menopausia routes)
PIXEL_ID_MENOPAUSIA=
# Meta Conversions API (server-side)
META_CAPI_TOKEN_MENOPAUSIA=
# Optional: Meta test event code for the Events Manager "Test events" tab
META_CAPI_TEST_EVENT_CODE=
