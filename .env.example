# ─── Menopausia Plana funnel ────────────────────────────────────────────────
# Dodo Payments (https://app.dodopayments.com → Developer → API keys)
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
# test_mode | live_mode
DODO_PAYMENTS_ENVIRONMENT=test_mode

# Public base URL used to build Dodo return_url (no trailing slash).
# Local: http://localhost:4321 · Prod: https://tu-dominio.com
PUBLIC_SITE_URL=http://localhost:4321

# Meta Pixel (client) — loads only on /menopausia routes
NEXT_PUBLIC_META_PIXEL_ID_MENOPAUSIA=
# Meta Conversions API (server-side)
META_CAPI_TOKEN_MENOPAUSIA=
# Optional: Meta test event code for the Events Manager "Test events" tab
META_CAPI_TEST_EVENT_CODE=
