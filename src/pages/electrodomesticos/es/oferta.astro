---
import ElectroLayout from '../../../layouts/ElectroLayout.astro';
import { Landing } from '../../../components/electrodomesticos/Landing';
import { texts } from '../../../config/electrodomesticos';
import { listImages } from '../../../lib/electrodomesticos/images';

// Página estática: las imágenes presentes se detectan en el build.
const images = listImages();
---

<ElectroLayout title={texts.meta.title} description={texts.meta.description}>
  <Landing images={images} client:load />
</ElectroLayout>
