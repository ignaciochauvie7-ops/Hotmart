---
export const prerender = false;

import ElectroLayout from '../../../layouts/ElectroLayout.astro';
import { Gracias } from '../../../components/electrodomesticos/Gracias';
import { PRICE_UPSELL, texts } from '../../../config/electrodomesticos';
import { getDodoClient, retrievePayment, paymentIsPaid } from '../../../lib/menopausia/dodo';

// Llega desde "No, gracias" (sin parámetros) o desde el checkout del upsell
// (?upsell=1&payment_id=…&status=…).
const params = Astro.url.searchParams;
const fromUpsell = params.get('upsell') === '1';
const paymentId = params.get('payment_id') ?? '';
const statusParam = (params.get('status') ?? '').toLowerCase();

let upsellPaid = false;
let upsellPending = false;
let value = PRICE_UPSELL;

if (fromUpsell) {
  const client = getDodoClient();
  if (client && paymentId) {
    const p: any = await retrievePayment(client, paymentId);
    const isUpsell = p?.metadata?.funnel === 'electrodomesticos' && p?.metadata?.kind === 'upsell';
    upsellPaid = isUpsell && paymentIsPaid(p);
    // Cobro en un clic aún en curso: ni confirmado ni fallido.
    upsellPending = isUpsell && String(p?.status ?? '').toLowerCase() === 'processing';
    if (typeof p?.total_amount === 'number') value = p.total_amount / 100;
  } else if (!client && import.meta.env.DEV && statusParam === 'succeeded') {
    upsellPaid = true; // Solo en local, sin Dodo configurado.
  }
}
---

<ElectroLayout title={texts.meta.thanksTitle} noindex>
  <Gracias fromUpsell={fromUpsell} upsellPaid={upsellPaid} upsellPending={upsellPending} value={value} paymentId={paymentId} client:load />
</ElectroLayout>
