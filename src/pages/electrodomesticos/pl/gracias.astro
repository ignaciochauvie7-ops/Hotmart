---
export const prerender = false;

import ElectroLayout from '../../../layouts/ElectroLayoutPl.astro';
import { Gracias } from '../../../components/electrodomesticos/pl/Gracias';
import { PRICE_UPSELL, texts } from '../../../config/electrodomesticos-pl';
import { deliveryFiles } from '../../../config/electrodomesticos-pl-entrega';
import { getDodoClient } from '../../../lib/menopausia/dodo';
import { downloadUrl, grantsAccess, loadPurchases, type DownloadButton } from '../../../lib/electrodomesticos/pl/entrega';

// Llega con el id de pago en la URL:
//   · desde el upsell rechazado → ?payment_id=<pago principal>
//   · desde el checkout del upsell → ?upsell=1&main=<pago principal>&payment_id=<pago del upsell>&status=…
//   · desde el post compra (cobro en un clic) → ?payment_id=<pago principal>&x=<cobros aún en curso>
// El acceso sale siempre de Dodo: se consultan esos pagos y, con uno confirmado,
// se muestran todas las compras pagadas del mismo comprador (por su email).
const params = Astro.url.searchParams;
const paymentId = params.get('payment_id') ?? '';
const mainId = params.get('main') ?? '';
// Cobros en un clic que seguían en curso al salir del post compra (máx. 2).
const extraIds = (params.get('x') ?? '').split(',').slice(0, 2);
const statusParam = (params.get('status') ?? '').toLowerCase();

let verified = false;
let pending = false;
let downloads: DownloadButton[] = [];
let upsellPaymentId = '';
let upsellValue = PRICE_UPSELL;

const client = getDodoClient();
if (client) {
  const r = await loadPurchases(client, [paymentId, mainId, ...extraIds]);
  verified = r.verified;
  pending = r.pending;
  downloads = r.downloads;
  // Purchase del upsell en el pixel: solo si ESE pago está confirmado.
  const p = r.seen[paymentId];
  if (p && p.metadata?.kind === 'upsell' && grantsAccess(p)) {
    upsellPaymentId = paymentId;
    if (typeof p.total_amount === 'number') upsellValue = p.total_amount / 100;
  }
} else if (import.meta.env.DEV && (statusParam === 'succeeded' || params.has('demo'))) {
  // Solo en local, sin Dodo configurado, para ver la página.
  verified = true;
  downloads = deliveryFiles.map((f) => ({ key: f.key, label: f.label, url: downloadUrl('dev', f.key) }));
}

Astro.response.headers.set('Cache-Control', 'private, no-store');
---

<ElectroLayout title={texts.meta.thanksTitle} noindex>
  <Gracias
    verified={verified}
    pending={pending}
    downloads={downloads}
    upsellPaymentId={upsellPaymentId}
    upsellValue={upsellValue}
    client:load
  />
</ElectroLayout>
