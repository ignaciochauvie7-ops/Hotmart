---
import ElectroLayout from '../../../layouts/ElectroLayoutPl.astro';
import { BASE_PATH, SUPPORT_EMAIL, texts } from '../../../config/electrodomesticos-pl';

const l = texts.legal;
---

<ElectroLayout title={`${l.termsTitle} — ${texts.meta.legalSuffix}`}>
  <main class="rp-simple rp-legal">
    <h1>{l.termsTitle}</h1>
    {l.termsBody.map((p) => <p>{p}</p>)}
    {SUPPORT_EMAIL && <p>{texts.footer.contact} <a href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a></p>}
    <a class="rp-btn rp-btn--ghost" href={`${BASE_PATH}/oferta`}>{l.back}</a>
  </main>
</ElectroLayout>
