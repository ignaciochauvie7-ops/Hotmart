---
export const prerender = false;

import MenoLayout from '../../../layouts/MenoLayout.astro';
import { Gracias } from '../../../components/menopausia/Gracias';
import { getDict, isLocale } from '../../../config/menopausia/i18n';
import { getDodoClient, retrievePayment, paymentIsPaid } from '../../../lib/menopausia/dodo';
import { bucketsFromPayment, buildDownloads, type DownloadLink } from '../../../lib/menopausia/order';
import { getPricing, type ProductBucket } from '../../../config/menopausia/products';

const { locale } = Astro.params;
if (!isLocale(locale)) return Astro.redirect('/menopausia/es');
const dict = getDict(locale);

const params = Astro.url.searchParams;
const paymentId = params.get('payment_id') ?? '';
const statusParam = (params.get('status') ?? '').toLowerCase();
let email = params.get('email') ?? undefined;

let paid = false;
let value = getPricing(locale).main;
let currency = getPricing(locale).currency;
let downloads: DownloadLink[] = [];

const client = getDodoClient();
if (client && paymentId) {
  const p: any = await retrievePayment(client, paymentId);
  paid = paymentIsPaid(p);
  if (typeof p?.total_amount === 'number') value = p.total_amount / 100;
  if (p?.currency) currency = p.currency;
  if (p?.customer?.email) email = p.customer.email;
  if (paid) {
    // Buyer is on /gracias → main is always included; add bump if purchased.
    const buckets: ProductBucket[] = ['main'];
    const fromCart = bucketsFromPayment(locale, p);
    if (fromCart.includes('bump') || p?.metadata?.bump === 'true') buckets.push('bump');
    downloads = buildDownloads(locale, paymentId, buckets);
  }
} else if (!client && statusParam === 'succeeded') {
  paid = true; // Dev/local fallback when Dodo isn't configured.
}
---

<MenoLayout locale={locale} title={dict.meta.graciasTitle} noindex>
  <Gracias
    locale={locale}
    paid={paid}
    value={value}
    currency={currency}
    eventId={paymentId}
    email={email}
    downloads={downloads}
    client:load
  />
</MenoLayout>
