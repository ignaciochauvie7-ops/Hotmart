---
import MenoLayout from '../../../layouts/MenoLayout.astro';
import { Offer } from '../../../components/menopausia/Offer';
import { getDict, isLocale, LOCALES } from '../../../config/menopausia/i18n';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;
if (!isLocale(locale)) return Astro.redirect('/menopausia/es');
const dict = getDict(locale);

// Email de soporte opcional: si no existe, la UI no muestra ese dato.
const supportEmail = import.meta.env.SUPPORT_EMAIL ?? process.env.SUPPORT_EMAIL ?? '';
---

<MenoLayout locale={locale} title={dict.meta.offerTitle} description={dict.meta.offerDesc}>
  <Offer locale={locale} supportEmail={supportEmail} client:load />
</MenoLayout>
