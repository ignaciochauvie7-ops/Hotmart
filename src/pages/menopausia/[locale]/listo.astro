---
export const prerender = false;

import MenoLayout from '../../../layouts/MenoLayout.astro';
import { Listo } from '../../../components/menopausia/Listo';
import { getDict, isLocale } from '../../../config/menopausia/i18n';
import { getDodoClient, retrievePayment, paymentIsPaid } from '../../../lib/menopausia/dodo';
import { buildDownloads, type DownloadLink } from '../../../lib/menopausia/order';
import { getPricing } from '../../../config/menopausia/products';

const { locale } = Astro.params;
if (!isLocale(locale)) return Astro.redirect('/menopausia/es');
const dict = getDict(locale);

const params = Astro.url.searchParams;
const fromUpsell = params.get('upsell') === '1';
const paymentId = params.get('payment_id') ?? '';
const statusParam = (params.get('status') ?? '').toLowerCase();

let upsellPaid = false;
let value = getPricing(locale).upsell;
let currency = getPricing(locale).currency;
let downloads: DownloadLink[] = [];

if (fromUpsell) {
  const client = getDodoClient();
  if (client && paymentId) {
    const p: any = await retrievePayment(client, paymentId);
    upsellPaid = paymentIsPaid(p);
    if (typeof p?.total_amount === 'number') value = p.total_amount / 100;
    if (p?.currency) currency = p.currency;
    if (upsellPaid) downloads = buildDownloads(locale, paymentId, ['upsell']);
  } else if (!client && statusParam === 'succeeded') {
    upsellPaid = true;
  }
}
---

<MenoLayout locale={locale} title={dict.meta.listoTitle} noindex>
  <Listo
    locale={locale}
    upsellPaid={upsellPaid}
    value={value}
    currency={currency}
    eventId={paymentId}
    downloads={downloads}
    client:load
  />
</MenoLayout>
