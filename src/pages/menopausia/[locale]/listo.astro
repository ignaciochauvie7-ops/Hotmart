---
export const prerender = false;

import MenoLayout from '../../../layouts/MenoLayout.astro';
import { Listo } from '../../../components/menopausia/Listo';
import { getDict, isLocale } from '../../../config/menopausia/i18n';
import { getDodoClient, retrievePayment } from '../../../lib/menopausia/dodo';
import { prices } from '../../../config/menopausia/products';

const { locale } = Astro.params;
if (!isLocale(locale)) return Astro.redirect('/menopausia/es');
const dict = getDict(locale);

const params = Astro.url.searchParams;
const fromUpsell = params.get('upsell') === '1';
const paymentId = params.get('payment_id') ?? '';
const statusParam = (params.get('status') ?? '').toLowerCase();

let upsellPaid = false;
let value = prices.upsell;
let currency = 'EUR';

if (fromUpsell) {
  const client = getDodoClient();
  if (client && paymentId) {
    const p: any = await retrievePayment(client, paymentId);
    const st = String(p?.status ?? '').toLowerCase();
    upsellPaid = st === 'succeeded' || st === 'paid' || st === 'active';
    if (typeof p?.total_amount === 'number') value = p.total_amount / 100;
    if (p?.currency) currency = p.currency;
  } else if (!client && statusParam === 'succeeded') {
    upsellPaid = true;
  }
}
---

<MenoLayout locale={locale} title={dict.meta.listoTitle} noindex>
  <Listo
    locale={locale}
    upsellPaid={upsellPaid}
    value={value}
    currency={currency}
    eventId={paymentId}
    client:load
  />
</MenoLayout>
