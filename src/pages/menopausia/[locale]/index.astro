---
import MenoLayout from '../../../layouts/MenoLayout.astro';
import { Quiz } from '../../../components/menopausia/Quiz';
import { getDict, isLocale, LOCALES } from '../../../config/menopausia/i18n';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;
if (!isLocale(locale)) return Astro.redirect('/menopausia/es');
const dict = getDict(locale);
---

<MenoLayout locale={locale} title={dict.meta.quizTitle} description={dict.meta.quizDesc}>
  <link
    slot="head"
    rel="preload"
    as="image"
    href="/menopausia/portada.webp"
    fetchpriority="high"
  />
  <Quiz locale={locale} dict={dict} client:load />
</MenoLayout>
