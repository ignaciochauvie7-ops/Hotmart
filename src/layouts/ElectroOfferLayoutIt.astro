---
// Landing /electrodomesticos/es/oferta: reutiliza tal cual el sistema de diseño
// de menopausia (clases .m-*) y solo cambia la paleta (electrodomesticos-oferta.css).
import '../styles/menopausia.css';
import '../styles/electrodomesticos-oferta.css';
import MetaPixel from '../components/menopausia/MetaPixel.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = '' } = Astro.props;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    {description && <meta name="description" content={description} />}
    <meta name="theme-color" content="#F4F6FA" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" as="font" type="font/woff2" href="/menopausia/fonts/lora-600-latin.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/menopausia/fonts/inter-400-latin.woff2" crossorigin />
    <slot name="head" />
    <!--
      Mismas fuentes que /menopausia/fonts/fonts.css, pero en línea (sin CSS
      bloqueante aparte) y con un solo archivo por familia: los .woff2 de cada
      peso son el mismo archivo variable, así que se declara el rango de pesos
      y el navegador lo descarga una vez en lugar de una por peso.
    -->
    <style is:inline>
      @font-face{font-family:'Inter';font-style:normal;font-weight:400 700;font-display:swap;src:url('/menopausia/fonts/inter-400-latin-ext.woff2') format('woff2');unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C4,U+2113,U+2C60-2C7F,U+A720-A7FF}
      @font-face{font-family:'Inter';font-style:normal;font-weight:400 700;font-display:swap;src:url('/menopausia/fonts/inter-400-latin.woff2') format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
      @font-face{font-family:'Lora';font-style:normal;font-weight:500 700;font-display:swap;src:url('/menopausia/fonts/lora-600-latin-ext.woff2') format('woff2');unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C4,U+2113,U+2C60-2C7F,U+A720-A7FF}
      @font-face{font-family:'Lora';font-style:normal;font-weight:500 700;font-display:swap;src:url('/menopausia/fonts/lora-600-latin.woff2') format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
    </style>
    <title>{title}</title>
    <MetaPixel defer />
  </head>
  <body>
    <div class="m-root rp-theme">
      <slot />
    </div>
  </body>
</html>
