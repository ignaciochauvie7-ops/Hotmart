---
interface Props {
  nombre: string;
  compact?: boolean;
}

const { nombre, compact = false } = Astro.props;
---

<div class:list={['cover', { 'cover--compact': compact }]}>
  <div class="cover__accent" aria-hidden="true"></div>
  <p class="cover__label">BerichBusiness</p>
  <h2 class="cover__title">{nombre}</h2>
</div>

<style>
  .cover {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    width: 100%;
    height: 100%;
    min-height: 220px;
    padding: var(--space-md);
    background: linear-gradient(145deg, #1b2a4a 0%, #243759 100%);
    position: relative;
    overflow: hidden;
  }

  .cover--compact {
    min-height: 160px;
    padding: var(--space-sm);
  }

  .cover__accent {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 5px;
    background: var(--color-coral);
  }

  .cover__label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.65);
    margin-bottom: 0.5rem;
  }

  .cover__title {
    font-size: clamp(1.125rem, 3vw, 1.5rem);
    font-weight: 700;
    line-height: 1.25;
    color: #ffffff;
    letter-spacing: -0.02em;
  }

  .cover--compact .cover__title {
    font-size: 1rem;
  }
</style>
